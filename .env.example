# IMovies - Environment Configuration Template
# Duplicate this file as .env and fill in your values. Do NOT commit .env to Git.

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/imovies?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/imovies

# Authentication
# Provide a secure random string for JWT token signing in production
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS configuration in production)
FRONTEND_URL=http://localhost:5173

# Admin default setup credentials (optional seed)
ADMIN_DEFAULT_EMAIL=admin@imovies.com
ADMIN_DEFAULT_PASSWORD=AdminPass123!
